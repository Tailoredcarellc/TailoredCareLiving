    {
      "parameters": {
        "jsCode": "// Merge the validated sheet row with the submitted name/acknowledgment and\n// the requester's IP address, captured server-side (never trust a client-sent IP).\nconst session = $('Validate Token (Submit)').first().json;\nconst trigger = $('Signature Submitted').first().json;\nconst body = trigger.body || {};\nconst headers = trigger.headers || {};\n\nconst typedName = String(body.typedName || '').trim().slice(0, 120);\nconst acknowledge = body.acknowledge === true;\nif (!typedName || !acknowledge) {\n  throw new Error('Please type your full legal name and check the acknowledgment box.');\n}\n\nconst ip = String(headers['x-forwarded-for'] || headers['x-real-ip'] || '').split(',')[0].trim() || 'Unknown';\n\nreturn [{\n  json: {\n    ...session,\n    signerName: typedName,\n    signerIp: ip,\n    signedAt: new Date().toISOString()\n  }\n}];"
      },

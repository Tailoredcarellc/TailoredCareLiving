    {
      "parameters": {
        "jsCode": "// Shared lookup: find the sheet row matching the token from the querystring (GET)\n// or JSON body (POST), and confirm it is a live, unsigned, accepted acknowledgment.\nconst trigger = $('Session Requested').first().json;\nconst token = String(trigger.query && trigger.query.token || '').trim();\nconst rows = $input.all();\n\nconst CONFIG = {\n  docVersion: 'Version 1.0 (Effective July 1, 2026)',\n  docUrl: 'https://docs.google.com/document/d/1zWTDSsVz12291QddViQqPqIw2ul4R37z/edit?usp=sharing'\n};\n\nif (!token) {\n  return [{ json: { ok: false, message: 'This acknowledgment link is missing information.' } }];\n}\n\nconst match = rows.find((item) => String(item.json['P&P Sign Token'] || '').trim() === token);\nif (!match) {\n  return [{ json: { ok: false, message: 'This acknowledgment link is invalid or has expired.' } }];\n}\n\nconst acceptance = String(match.json['Acceptance Status'] || '').trim().toLowerCase();\nconst signStatus = String(match.json['P&P Sign Status'] || '').trim().toLowerCase();\nif (acceptance !== 'accepted') {\n  return [{ json: { ok: false, message: 'This acknowledgment link is invalid or has expired.' } }];\n}\nif (signStatus === 'signed') {\n  return [{ json: { ok: false, message: 'This acknowledgment has already been signed.' } }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    row_number: match.json.row_number,\n    fullName: match.json['Full Name'],\n    email: match.json['Email'],\n    docVersion: CONFIG.docVersion,\n    docUrl: CONFIG.docUrl\n  }\n}];"
      },

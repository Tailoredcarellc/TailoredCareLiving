    {
      "parameters": {
        "jsCode": "// Validate the admin's decision before writing it to the sheet.\nconst trigger = $('Decision Submitted').first().json;\nconst body = trigger.body || {};\nconst rowNumber = Number(body.row_number);\nconst decision = String(body.decision || '').trim();\n\nif (!rowNumber || !['Accepted', 'Declined'].includes(decision)) {\n  throw new Error('A valid row_number and decision (Accepted or Declined) are required.');\n}\n\nreturn [{ json: { row_number: rowNumber, decision } }];"
      },
      "id": "b2-validate-decision",

    {
      "parameters": {
        "jsCode": "// Show only applicants who have not yet been marked Accepted or Declined.\nconst rows = $input.all();\nconst pending = rows.filter((item) => !String(item.json['Acceptance Status'] || '').trim());\n\nreturn pending.map((item) => ({\n  json: {\n    row_number: item.json.row_number,\n    reference: item.json['Reference'],\n    receivedAt: item.json['Received At'],\n    fullName: item.json['Full Name'],\n    phone: item.json['Phone'],\n    email: item.json['Email'],\n    bestContactTime: item.json['Best Contact Time'],\n    applyingFor: item.json['Applying For'],\n    occupants: item.json['Total Occupants'],\n    occupantAges: item.json['Occupant Ages'],\n    moveIn: item.json['Move-In Timeframe'],\n    currentHousing: item.json['Current Housing Situation'],\n    housingOnly: item.json['Housing Only'],\n    paymentSource: item.json['Payment Source'],\n    additional: item.json['Additional Information']\n  }\n}));"
      },
      "id": "a3-filter-pending",
      "name": "Filter Pending",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,

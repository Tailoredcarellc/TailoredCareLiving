    {
      "parameters": {
        "jsCode": "// Keep only rows the business has marked Accepted that have not been sent a\n// signing link yet. Generates a random per-resident token used to build the\n// unique sign.html link and to look the row back up when they sign.\nconst rows = $input.all();\nconst qualifying = rows.filter((item) => {\n  const acceptance = String(item.json['Acceptance Status'] || '').trim().toLowerCase();\n  const signStatus = String(item.json['P&P Sign Status'] || '').trim();\n  const email = String(item.json['Email'] || '').trim();\n  return acceptance === 'accepted' && !signStatus && email;\n});\n\nfunction makeToken() {\n  try {\n    return require('crypto').randomUUID().replace(/-/g, '');\n  } catch (error) {\n    return Array.from({ length: 32 }, () => Math.floor(Math.random() * 16).toString(16)).join('');\n  }\n}\n\nreturn qualifying.map((item) => ({\n  json: {\n    ...item.json,\n    signToken: makeToken(),\n    sentAt: new Date().toISOString()\n  }\n}));"
      },
      "id": "03-filter-accepted",
      "name": "Find Accepted, Unsent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

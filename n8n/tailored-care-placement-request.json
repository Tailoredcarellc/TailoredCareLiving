    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst clean = (value, limit = 1500) => String(value ?? '').trim().slice(0, limit);\n\nif (clean(body.website)) throw new Error('Submission rejected.');\nconst startedAt = Number(body.startedAt || 0);\nif (!startedAt || Date.now() - startedAt < 3000) throw new Error('Submission was too fast.');\n\nconst data = {\n  requesterRole: clean(body.requesterRole, 60),\n  requesterName: clean(body.requesterName, 120),\n  organization: clean(body.organization, 160),\n  requesterPhone: clean(body.requesterPhone, 30),\n  requesterEmail: clean(body.requesterEmail, 160),\n  bestTime: clean(body.bestTime, 40),\n  clientFirstName: clean(body.clientFirstName, 80),\n  clientLastName: clean(body.clientLastName, 80),\n  clientDob: clean(body.clientDob, 20),\n  clientPhone: clean(body.clientPhone, 30),\n  clientGender: clean(body.clientGender, 40),\n  preferredLanguage: clean(body.preferredLanguage, 60),\n  veteran: clean(body.veteran, 20),\n  currentLocation: clean(body.currentLocation, 200),\n  dischargeDate: clean(body.dischargeDate, 20),\n  decisionMaker: clean(body.decisionMaker, 60),\n  decisionMakerContact: clean(body.decisionMakerContact, 200),\n  settingTypes: clean(body.settingTypes, 400),\n  situations: clean(body.situations, 400),\n  moveIn: clean(body.moveIn, 40),\n  preferredArea: clean(body.preferredArea, 200),\n  areasToAvoid: clean(body.areasToAvoid, 200),\n  incomeSources: clean(body.incomeSources, 300),\n  monthlyIncome: clean(body.monthlyIncome, 40),\n  housingBudget: clean(body.housingBudget, 40),\n  hasPhotoId: clean(body.hasPhotoId, 20),\n  walksUnaided: clean(body.walksUnaided, 10),\n  mobilityAid: clean(body.mobilityAid, 10),\n  climbsStairs: clean(body.climbsStairs, 10),\n  managesMeds: clean(body.managesMeds, 10),\n  personalCare: clean(body.personalCare, 10),\n  mealHelp: clean(body.mealHelp, 10),\n  smokes: clean(body.smokes, 10),\n  pet: clean(body.pet, 10),\n  accommodations: clean(body.accommodations, 1500),\n  probation: clean(body.probation, 10),\n  residenceRestrictions: clean(body.residenceRestrictions, 10),\n  recoveryProgram: clean(body.recoveryProgram, 10),\n  activeCaseManager: clean(body.activeCaseManager, 10),\n  agentContact: clean(body.agentContact, 200),\n  additionalInfo: clean(body.additionalInfo, 1500),\n  signature: clean(body.signature, 120),\n  relationship: clean(body.relationship, 80),\n  consent: clean(body.consent, 10)\n};\ndata.requesterEmail = data.requesterEmail.toLowerCase();\n\nconst required = [\"requesterRole\", \"requesterName\", \"requesterPhone\", \"clientFirstName\", \"clientLastName\", \"moveIn\", \"signature\", \"consent\"];\nif (required.some((field) => !data[field])) throw new Error('Please complete all required fields.');\nif (data.requesterEmail && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(data.requesterEmail)) throw new Error('Please enter a valid email address.');\n\nconst date = new Date().toISOString().slice(0, 10).replaceAll('-', '');\nconst suffix = Math.floor(1000 + Math.random() * 9000);\nreturn [{ json: { ...data, status: 'New placement request — call to follow up', reference: `PL-${date}-${suffix}`, receivedAt: new Date().toISOString() } }];"
      },

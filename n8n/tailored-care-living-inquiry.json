    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tailored-care-living-inquiry",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://tailoredcarelivingllc.com,https://www.tailoredcarelivingllc.com,https://tailoredcarellc.github.io"
        }

    {
      "parameters": {
        "fromEmail": "Tailored Care Living <team@tailoredcarelivingllc.com>",
        "toEmail": "={{ $('Validate and Normalize').item.json.email }}",
        "subject": "=Tailored Care Living interest list — {{ $('Validate and Normalize').item.json.reference }}",
        "emailFormat": "text",
        "text": "=Hello {{ $('Validate and Normalize').item.json.fullName }},\n\nThank you for contacting Tailored Care Living. Your information has been added to the housing interest list.\n\nReference number: {{ $('Validate and Normalize').item.json.reference }}\n\nThe home is expected to be ready in the coming months. A member of the team will review your information and may contact you as opening plans and availability develop. Joining the list does not guarantee acceptance, placement, timing, or housing availability.\n\nPlease do not reply with Social Security, banking, medical, or benefit account numbers.\n\nTailored Care Living",
        "options": {
          "appendAttribution": false
        }
      },

      "id": "01-webhook",
      "name": "Housing Interest Submitted",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst clean = (value, limit = 1500) => String(value ?? '').trim().slice(0, limit);\n\nif (clean(body.website)) throw new Error('Submission rejected.');\nconst startedAt = Number(body.startedAt || 0);\nif (!startedAt || Date.now() - startedAt < 1500) throw new Error('Submission was too fast.');\n\nconst data = {\n  fullName: clean(body.fullName, 120),\n  phone: clean(body.phone, 30),\n  email: clean(body.email, 160).toLowerCase(),\n  bestContactTime: clean(body.bestContactTime, 40),\n  applyingFor: clean(body.applyingFor, 40),\n  occupants: clean(body.occupants, 3),\n  occupantAges: clean(body.occupantAges, 100),\n  moveIn: clean(body.moveIn, 60),\n  currentHousing: clean(body.currentHousing, 1000),\n  housingOnly: clean(body.housingOnly, 80),\n  paymentSource: clean(body.paymentSource, 80),\n  additional: clean(body.additional, 1500),\n  consent: clean(body.consent, 10)\n};\n\nconst required = ['fullName','phone','bestContactTime','applyingFor','occupants','occupantAges','moveIn','currentHousing','housingOnly','paymentSource','consent'];\nif (required.some((field) => !data[field])) throw new Error('Please complete all required fields.');\nif (!/^\\d{1,2}$/.test(data.occupants) || Number(data.occupants) < 1 || Number(data.occupants) > 20) throw new Error('Please enter a valid number of occupants.');\nconst ages = data.occupantAges.split(',').map(age => age.trim()).filter(Boolean);\nif (ages.length !== Number(data.occupants) || ages.some(age => !/^\\d{1,3}$/.test(age) || Number(age) < 0 || Number(age) > 120)) throw new Error('Please enter one valid age for each proposed occupant.');\nif (data.email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(data.email)) throw new Error('Please enter a valid email address.');\n\nconst date = new Date().toISOString().slice(0, 10).replaceAll('-', '');\nconst suffix = Math.floor(1000 + Math.random() * 9000);\nreturn [{ json: { ...data, waitingListStatus: 'Housing interest list — pending individual review', reference: `TCL-${date}-${suffix}`, receivedAt: new Date().toISOString() } }];"
      },
      "id": "02-validate",
      "name": "Validate and Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

      ]
    },
    {
      "parameters": {
        "fromEmail": "Tailored Care Living <team@tailoredcarelivingllc.com>",
        "toEmail": "team@tailoredcarelivingllc.com",
        "subject": "=New housing interest-list submission — {{ $('Validate and Normalize').item.json.reference }}",
        "emailFormat": "text",
        "text": "=A new housing interest-list submission was received through the Tailored Care Living website.\n\nStatus: {{ $('Validate and Normalize').item.json.waitingListStatus }}\nReference: {{ $('Validate and Normalize').item.json.reference }}\nReceived: {{ $('Validate and Normalize').item.json.receivedAt }}\n\nCONTACT\nName: {{ $('Validate and Normalize').item.json.fullName }}\nPhone: {{ $('Validate and Normalize').item.json.phone }}\nEmail: {{ $('Validate and Normalize').item.json.email || 'Not provided' }}\nBest time to call: {{ $('Validate and Normalize').item.json.bestContactTime }}\n\nHOUSEHOLD AND HOUSING NEED\nSeeking housing for: {{ $('Validate and Normalize').item.json.applyingFor }}\nTotal proposed occupants: {{ $('Validate and Normalize').item.json.occupants }}\nAges of proposed occupants: {{ $('Validate and Normalize').item.json.occupantAges }}\nMove-in timeframe: {{ $('Validate and Normalize').item.json.moveIn }}\nCurrent housing situation: {{ $('Validate and Normalize').item.json.currentHousing }}\n\nHOUSING SERVICES\nSeeking housing-only accommodations: {{ $('Validate and Normalize').item.json.housingOnly }}\nExpected payment source: {{ $('Validate and Normalize').item.json.paymentSource }}\n\nADDITIONAL INFORMATION\n{{ $('Validate and Normalize').item.json.additional || 'Not provided' }}\n\nThis submission requires individual human review. Do not approve or reject an applicant based only on an occupant's age or familial status.",
        "options": {
          "appendAttribution": false
        }
      },
